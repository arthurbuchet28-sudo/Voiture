  "cues": [
   {
    "text": "Dix ans plus tard, Einstein va plus loin.",
    "start": 0.403,
    "end": 2.758
   },
   {
    "text": "La gravité n'est pas une force mystérieuse :",
    "start": 3.668,
    "end": 5.997
   },
   {
    "text": "c'est une déformation de l'espace et du temps.",
    "start": 6.234,
    "end": 8.274
   },
   {
    "text": "Plus on est proche d'une masse, plus le temps s'écoule lentement.",
    "start": 9.195,
    "end": 12.379
   },
   {
    "text": "Votre tête vieillit un tout petit peu plus vite que vos pieds !",
    "start": 13.287,
    "end": 16.129
   },
   {
    "text": "En mille neuf cent soixante et onze,",
    "start": 17.037,
    "end": 18.458
   },
   {
    "text": "Joseph Hafele et Richard Keating ont embarqué des",
    "start": 18.813,
    "end": 21.089
   },
   {
    "text": "horloges atomiques au césium dans des avions de ligne,",
    "start": 21.103,
    "end": 23.524
   },
   {
    "text": "pour deux tours du monde.",
    "start": 23.813,
    "end": 24.853
   },
   {
    "text": "Comparées aux horloges restées au sol,",
    "start": 25.774,
    "end": 27.484
   },
   {
    "text": "elles avaient perdu cinquante-neuf nanosecondes vers",
    "start": 27.839,
    "end": 30.011
   },
   {
    "text": "l'est et gagné deux cent soixante-treize vers l'ouest.",
    "start": 30.024,
    "end": 32.339
   },
   {
    "text": "Exactement ce que prédisait la théorie.",
    "start": 33.261,
    "end": 35.366
   }
  ]
 },
