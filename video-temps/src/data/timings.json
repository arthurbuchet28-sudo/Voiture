  "cues": [
   {
    "text": "Imaginez deux jumeaux, Léa et Hugo.",
    "start": 0.403,
    "end": 2.587
   },
   {
    "text": "Le jour de leurs trente ans,",
    "start": 3.497,
    "end": 4.695
   },
   {
    "text": "Léa embarque dans une fusée qui file à près de",
    "start": 5.076,
    "end": 7.063
   },
   {
    "text": "quatre-vingt-sept pour cent de la vitesse de la lumière.",
    "start": 7.076,
    "end": 9.497
   },
   {
    "text": "Hugo, lui, reste sur Terre.",
    "start": 10.418,
    "end": 12.616
   },
   {
    "text": "Quand Léa revient, Hugo a fêté dix anniversaires…",
    "start": 13.537,
    "end": 16.3
   },
   {
    "text": "mais Léa n'en a vécu que cinq.",
    "start": 16.537,
    "end": 18.076
   },
   {
    "text": "Ce n'est pas de la science-fiction : c'est ce que prédit la physique,",
    "start": 18.997,
    "end": 21.945
   },
   {
    "text": "et ce que mesurent nos horloges atomiques.",
    "start": 22.261,
    "end": 24.129
   },
   {
    "text": "Alors, le temps est-il vraiment le même pour tout le monde ?",
    "start": 25.05,
    "end": 27.984
   }
  ]
 },
