  "cues": [
   {
    "text": "Et tout cela se joue dans votre poche.",
    "start": 0.403,
    "end": 2.35
   },
   {
    "text": "Les satellites GPS tournent à une vingtaine de milliers de kilomètres d'altitude,",
    "start": 3.274,
    "end": 6.984
   },
   {
    "text": "à près de quatre kilomètres par seconde.",
    "start": 7.287,
    "end": 9.353
   },
   {
    "text": "Là-haut,",
    "start": 10.261,
    "end": 10.682
   },
   {
    "text": "la gravité plus faible fait avancer leurs horloges",
    "start": 11.024,
    "end": 13.353
   },
   {
    "text": "d'environ quarante-cinq microsecondes par jour.",
    "start": 13.366,
    "end": 15.695
   },
   {
    "text": "Leur vitesse, elle, les ralentit d'environ sept microsecondes.",
    "start": 16.603,
    "end": 20.471
   },
   {
    "text": "Bilan : trente-huit microsecondes d'avance chaque jour.",
    "start": 21.392,
    "end": 24.182
   },
   {
    "text": "Or la lumière parcourt trente centimètres en une nanoseconde : sans correction,",
    "start": 25.103,
    "end": 28.839
   },
   {
    "text": "la position calculée dériverait d'une dizaine de kilomètres par jour.",
    "start": 29.221,
    "end": 32.708
   },
   {
    "text": "C'est pourquoi les horloges des satellites sont",
    "start": 33.616,
    "end": 35.524
   },
   {
    "text": "volontairement réglées un peu plus lentes avant le lancement.",
    "start": 35.537,
    "end": 37.971
   }
  ]
